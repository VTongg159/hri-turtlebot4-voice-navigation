# Local environments and build outputs
/.venv/
/build/
/install/
/log/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
*.egg-info/

# Reports, recordings, and experiment output stay local
/docs/
/submission/
/evidence/*
!/evidence/README.md
!/evidence/pairs_lab/
/deliverables/
*.pdf
*.tex
*.wav
*.mp4
*.mkv
*.db3
*.mcap
*.aux
*.toc
*.lof
*.lot
*.out
*.synctex.gz

# Keep only application utilities in the top-level scripts directory
/scripts/*
!/scripts/download_model.py
!/scripts/initialize_localization.py
!/scripts/pairslab_camera.py

# Local RViz layouts used for report screenshots
/src/tb4_voice_navigation/rviz/pairs_lab_idle.rviz
/src/tb4_voice_navigation/rviz/pairs_lab_multiwaypoint.rviz
/src/tb4_voice_navigation/rviz/pairs_lab_report.rviz
/src/tb4_voice_navigation/rviz/pairs_lab_source_destination.rviz

# Model caches and local secrets
*.pt
*.onnx
.env
.env.*
*.key
*.pem
