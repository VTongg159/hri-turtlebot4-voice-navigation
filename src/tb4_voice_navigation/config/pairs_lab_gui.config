<?xml version="1.0"?>
<window>
  <width>1600</width><height>1000</height>
  <menus><drawer default="false"/></menus>
  <dialog_on_exit>false</dialog_on_exit>
</window>
<plugin filename="MinimalScene" name="3D View">
  <gz-gui><title>PAIRS Robotics Research Lab</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></gz-gui>
  <engine>ogre2</engine><scene>scene</scene>
  <ambient_light>0.65 0.65 0.65</ambient_light>
  <background_color>0.93 0.95 0.97</background_color>
  <camera_pose>14 -19 22 0 0.746 2.206</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager"><gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
<plugin filename="InteractiveViewControl" name="View control"><gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
<plugin filename="CameraTracking" name="Camera Tracking"><gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
